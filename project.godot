config_version=5

[application]

config/name="Fnaf [Nombre Provisional]"
run/main_scene="uid://b5m4l3jyq8cco"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dilppckdl624k"

[autoload]

Global="*res://scripts/Global/Global.gd"
Bonnie="*res://scripts/Global/bonnie.gd"
Chica="*res://scripts/Global/chica.gd"
Freddy="*res://scripts/Global/freddy.gd"
Foxy="*res://scripts/Global/foxy.gd"
Items="*res://scripts/Global/items.gd"
GlobalWorldEnvironment="*uid://c06jc4s8iwci4"
DirectionalAudioBus="*uid://dtkaosem2lgl1"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[global_group]

interactable="Area2D interactable on the night sections. It prevents overlaping with the flashlight"
minigame=""
scene_handler=""
